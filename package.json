{
  "name": "zcash-js-docs",
  "private": true,
  "description": "Documentation tooling for the proposed zcash.js API; no SDK runtime.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 4173 --strictPort",
    "docs:build": "vitepress build docs",
    "docs:preview": "vite preview --outDir docs/.vitepress/dist --host 127.0.0.1 --port 4173 --strictPort --base /",
    "docs:typecheck": "tsc -p docs/api/examples/tsconfig.json"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.20",
    "typescript": "6.0.3"
  }
}
